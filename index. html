    function toggleLanguage() {
      currentLang = currentLang === 'ur' ? 'en' : 'ur';
      renderLanguage(currentLang);
    }

    function renderLanguage(lang) {
      try {
        const dict = i18n[lang];
        const body = document.getElementById('pageBody');
        body.setAttribute('dir', dict.dir);
        body.setAttribute('lang', lang);
        body.classList.remove('urdu-mode', 'english-mode');
        body.classList.add(dict.fontClass);

        const ids = [
          'langSwitchLabel', 'topBannerText', 'topSohailLabel',
          'brandTitle', 'brandSub', 'navHome', 'navCatalog', 'navContact',
          'headerWaLabel', 'heroBadge', 'heroTitle', 'heroDesc',
          'heroSizesHeading', 'heroCallMain', 'heroLocalCall', 'heroWaBtn',
          'summaryTitle', 'summaryGroup', 'sumItem1', 'sumItem2', 'sumItem3', 'sumItem4',
          'sumGroupLabel', 'sumSohailLabel', 'catalogTag', 'catalogHeading',
          'tabAll', 'tabPressDoors', 'tabPanels', 'tabCncFiber', 'tabKitchenAlmariGoli',
          'card1Title', 'card1Desc', 'card2Title', 'card2Desc',
          'card3Title', 'card3Desc', 'card4Title', 'card4Desc',
          'card5Title', 'card5Desc', 'card6Title', 'card6Desc',
          'contactTag', 'contactHeading', 'infoBusinessLabel', 'infoBusinessName',
          'infoGroupName', 'infoMainPhoneLabel', 'infoSohailPhoneLabel',
          'infoAddressLabel', 'infoAddressValue', 'infoLocalCallBtn', 'infoWaBtn',
          'formTitle', 'formDesc', 'lblName', 'lblPhone', 'lblCategory',
          'lblDetails', 'lblNotes', 'submitFormBtn', 'footerBrand',
          'footerAddress', 'footerCopy'
        ];

        ids.forEach((id) => {
          const el = document.getElementById(id);
          if (el && dict[id] !== undefined) {
            el.textContent = dict[id];
          }
        });

        document.querySelectorAll('.badge-press').forEach((el) => { el.textContent = dict.badgePress; });
        document.querySelectorAll('.badge-panels').forEach((el) => { el.textContent = dict.badgePanels; });
        document.querySelectorAll('.badge-cnc').forEach((el) => { el.textContent = dict.badgeCnc; });
        document.querySelectorAll('.badge-kag').forEach((el) => { el.textContent = dict.badgeKag; });
        document.querySelectorAll('.wa-card-btn span').forEach((el) => { el.textContent = dict.waCardBtn; });

        document.getElementById('customerName').placeholder = dict.namePlaceholder;
        document.getElementById('customerPhone').placeholder = dict.phonePlaceholder;
        document.getElementById('orderDetails').placeholder = dict.detailsPlaceholder;
        document.getElementById('orderNotes').placeholder = dict.notesPlaceholder;

        const selectEl = document.getElementById('orderCategory');
        const selectedVal = selectEl.value;
        selectEl.innerHTML = '';
        dict.categoryOptions.forEach((item) => {
          const opt = document.createElement('option');
          opt.value = item.value;
          opt.textContent = item.label;
          if (item.value === selectedVal) {
            opt.selected = true;
          }
          selectEl.appendChild(opt);
        });
      } catch (error) {
        console.error('Language switch error:', error);
      }
    }

    function filterItems(category) {
      try {
        currentCategory = category;
        const cards = document.querySelectorAll('.catalog-card');
        cards.forEach((card) => {
          const cardCat = card.getAttribute('data-category');
          if (category === 'all' || cardCat === category) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });

        const tabs = document.querySelectorAll('.cat-tab');
        tabs.forEach((tab) => {
          const tabCat = tab.getAttribute('data-category');
          const active = tabCat === category;
          tab.setAttribute('aria-selected', String(active));
          if (active) {
            tab.classList.remove('bg-white', 'hover:bg-timber-100', 'text-stone-800', 'border-stone-300');
            tab.classList.add('bg-timber-900', 'text-brass', 'border-timber-900');
          } else {
            tab.classList.remove('bg-timber-900', 'text-brass', 'border-timber-900');
            tab.classList.add('bg-white', 'hover:bg-timber-100', 'text-stone-800', 'border-stone-300');
          }
        });
      } catch (error) {
        console.error('Category filter error:', error);
      }
    }

    function sendWhatsAppInquiry(event) {
      event.preventDefault();
      try {
        const name = document.getElementById('customerName').value.trim();
        const phone = document.getElementById('customerPhone').value.trim();
        const category = document.getElementById('orderCategory').value;
        const details = document.getElementById('orderDetails').value.trim();
        const notes = document.getElementById('orderNotes').value.trim();

        let message = '*HR Enterprises Inquiry*\n';
        message += `Name: ${name}\n`;
        message += `Phone: ${phone}\n`;
        message += `Item/Service: ${category}\n`;
        if (details) message += `Size/Details: ${details}\n`;
        if (notes) message += `Message: ${notes}\n`;

        const waUrl = `https://wa.me/923456998618?text=${encodeURIComponent(message)}`;
        window.open(waUrl, '_blank', 'noopener,noreferrer');

        const noticeEl = document.getElementById('formNotice');
        noticeEl.textContent = i18n[currentLang].noticeText;
        noticeEl.classList.remove('hidden');
      } catch (error) {
        console.error('WhatsApp form error:', error);
      }
    }
  </script>
